    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "firebase-tools": "^15.24.0",
    "playwright": "^1.62.0",
    "tailwindcss": "^4",
    "typescript": "^5",
