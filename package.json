{
  "name": "philodendron-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "ui:verify": "node scripts/verify-accessible-ui.mjs",
    "protocol:verify": "node scripts/verify-protocol-integrity.mjs",
    "calm-lab:verify": "node scripts/verify-calm-lab.mjs",
    "atlas:verify": "node scripts/verify-botanical-atlas.mjs",
    "terms:report": "node scripts/report-unwrapped-terms.mjs",
